generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SHOPKEEPER
  RIDER
  ADMIN
}




enum OtpPurpose {
  CUSTOMER_REGISTRATION
  SHOPKEEPER_REGISTRATION
  RIDER_REGISTRATION
  PASSWORD_RESET
}



model User {
  id           String   @id @default(uuid())
  name         String?
  phone        String   @unique
  email        String?  @unique
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)

  shop Shop?
  rider Rider?
  addresses Address[]
  carts Cart[]
  orders Order[]



  reviews Review[]

  checkoutPayments CheckoutPayment[]

  pushSubscriptions PushSubscription[]
  refundRequests RefundRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}






model Shop {
  id      String @id @default(uuid())
  ownerId String @unique
  name    String
  slug    String @unique

  phone   String
  address String

  latitude  Decimal?
  longitude Decimal?
  paymentAccount SellerPaymentAccount?

  isOpen   Boolean @default(true)
  isActive Boolean @default(true)

  verificationStatus ShopVerificationStatus @default(PENDING)
rejectionReason String?

  products Product[]
  carts Cart[]
  orders Order[]
  transfers Transfer[]

  ledgerEntries LedgerEntry[]
payouts       SellerPayout[]

  owner User @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}







model Address {
  id     String @id @default(uuid())
  userId String

  label       String
  fullAddress String
  city        String
  state       String
  pincode     String

  latitude  Decimal?
  longitude Decimal?

  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}







model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String @unique
  isActive Boolean @default(true)

  parentId String?

products Product[]

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Product {
  id          String  @id @default(uuid())
  shopId      String
  categoryId  String

  name        String
  slug        String
  description String?

  price       Decimal
  imageUrl    String?

  isAvailable Boolean @default(true)
  isFeatured Boolean @default(false)
  weightKg Float @default(1)

  shop        Shop     @relation(fields: [shopId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])

inventory Inventory?
cartItems CartItem[]
orderItems OrderItem[]
reviews Review[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
}




model Inventory {
  id               String @id @default(uuid())
  productId        String @unique

  quantity         Int @default(0)
  reservedQuantity Int @default(0)
  lowStockThreshold Int @default(5)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}






enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

model Cart {
  id         String     @id @default(uuid())
  customerId String
  shopId     String
  status     CartStatus @default(ACTIVE)

  customer User   @relation(fields: [customerId], references: [id])
  shop     Shop   @relation(fields: [shopId], references: [id])
  items    CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, shopId, status])
}




model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}









enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RiderStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
}



enum RiderVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}



enum ShopVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DeliveryStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}


enum LedgerEntryType {
  SALE
  COMMISSION
  REFUND
  ADJUSTMENT
  PAYOUT
}


enum LedgerEntryDirection {
  CREDIT
  DEBIT
}


enum SellerPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}









enum RiderPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum RiderLedgerEntryType {
  EARNING
  PAYOUT
  ADJUSTMENT
}

enum RiderLedgerEntryDirection {
  CREDIT
  DEBIT
}









enum CancellationReason {
  CHANGED_MIND
  ORDERED_BY_MISTAKE
  BETTER_PRICE
  DELIVERY_TAKING_TOO_LONG
  PRODUCT_NOT_NEEDED
  WRONG_PRODUCT_OR_QUANTITY
  OTHER
}





model Order {
  id          String @id @default(uuid())
  orderNumber String @unique

  customerId String
  shopId     String

  subtotal    Decimal
  deliveryFee Decimal
  platformFee Decimal
  total       Decimal



    commissionRate       Decimal @default(10)
  commissionAmount     Decimal @default(0)
  sellerPayableAmount  Decimal @default(0)



  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)



  cancelledAt       DateTime?
cancellationReason CancellationReason?
cancellationNote  String?
cancelledBy       String?

  // Delivery address snapshot
  deliveryName        String
  deliveryPhone       String
  deliveryFullAddress String
  deliveryCity        String
  deliveryState       String
  deliveryPincode     String
  deliveryLatitude    Decimal?
  deliveryLongitude   Decimal?

  payment Payment?
  

checkoutPaymentId String?
checkoutPayment   CheckoutPayment? @relation(fields: [checkoutPaymentId], references: [id])


  customer User @relation(fields: [customerId], references: [id])
  shop     Shop @relation(fields: [shopId], references: [id])

  items OrderItem[]
  transfers Transfer[]
  deliveries Delivery[]
  reviews Review[]
  refundRequests RefundRequest[]

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}






model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String

  productName String
  unitPrice   Decimal
  quantity    Int
  lineTotal   Decimal

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}






model Payment {
  id        String  @id @default(uuid())
  orderId   String  @unique

  provider  String?
  method    PaymentMethod
  amount    Decimal
  refundedAmount Decimal @default(0)
  currency  String @default("INR")

  providerOrderId   String? @unique
  providerPaymentId String? @unique
  

  status PaymentStatus @default(PENDING)

  paidAt      DateTime?
  failedAt    DateTime?
  refundedAt  DateTime?

  metadata Json?

  order Order @relation(fields: [orderId], references: [id])

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([method])
  @@index([createdAt])
}









model CheckoutPayment {
  id                String        @id @default(uuid())
  checkoutNumber    String        @unique
  amount            Decimal
  currency          String        @default("INR")
  method            PaymentMethod
  provider          String?
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAmount    Decimal       @default(0)
  refundedAt        DateTime?
  metadata          Json?

  customerId        String
  customer          User          @relation(fields: [customerId], references: [id])

  orders            Order[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
}







model Rider {
  id String @id @default(uuid())
  userId String @unique
  vehicleType String?

  status RiderStatus @default(OFFLINE)

  verificationStatus RiderVerificationStatus @default(PENDING)
  rejectionReason String?

  currentLatitude Decimal?
  currentLongitude Decimal?

  user User @relation(fields: [userId], references: [id])
  deliveries Delivery[]

  payouts RiderPayout[]
  ledgerEntries RiderLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}





model Delivery {
  id       String @id @default(uuid())
  orderId  String 
  riderId  String

  status DeliveryStatus @default(ASSIGNED)

  deliveryFee  Decimal
  riderEarning Decimal

  assignedAt  DateTime @default(now())
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  order Order @relation(fields: [orderId], references: [id])
  rider Rider @relation(fields: [riderId], references: [id])

  ledgerEntries RiderLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}









enum SellerPaymentAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model SellerPaymentAccount {
  id String @id @default(uuid())

  shopId String @unique

  provider String @default("razorpay")

  linkedAccountId String @unique

  status SellerPaymentAccountStatus @default(PENDING)


transfers Transfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])
}











enum TransferStatus {
  PENDING
  PROCESSED
  FAILED
  REVERSED
}

model Transfer {
  id String @id @default(uuid())

  orderId String
  shopId  String

  sellerPaymentAccountId String

  amount   Decimal
  currency String @default("INR")

  provider String @default("razorpay")

  razorpayTransferId String? @unique

  status TransferStatus @default(PENDING)

  processedAt DateTime?
  failedAt    DateTime?

  order                 Order                 @relation(fields: [orderId], references: [id])
  shop                  Shop                  @relation(fields: [shopId], references: [id])
  sellerPaymentAccount  SellerPaymentAccount @relation(fields: [sellerPaymentAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([shopId])
}









enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
}

model WebhookEvent {
  id String @id @default(uuid())

  provider String @default("razorpay")

  eventId   String @unique
  eventType String

  status WebhookEventStatus @default(PENDING)

  payload Json

  processedAt DateTime?
  failedAt    DateTime?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType])
  @@index([status])
}













model OtpVerification {
  id String @id @default(uuid())

  phone String

  purpose OtpPurpose

  sessionId String

  expiresAt DateTime

  attempts Int @default(0)

  verified Boolean @default(false)
  


  consumedAt    DateTime?
  invalidatedAt DateTime?

  lastSentAt DateTime @default(now())


  createdAt DateTime @default(now())

  @@index([phone])
  @@index([purpose])
  @@index([expiresAt])
}









model Review {
  id String @id @default(uuid())

  customerId String
  productId  String
  orderId    String

  rating  Int
  comment String?

  customer User    @relation(fields: [customerId], references: [id])
  product  Product @relation(fields: [productId], references: [id])
  order    Order   @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productId, orderId])
  @@index([productId])
  @@index([customerId])
  @@index([orderId])
}







model PushSubscription {
  id        String   @id @default(uuid())

  userId    String

  endpoint  String   @unique
  p256dh    String
  auth      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}







model LedgerEntry {
  id String @id @default(uuid())

  shopId String

  orderId   String?
  paymentId String?
  payoutId  String?

  type LedgerEntryType

  amount Decimal

  description String?

  referenceId String?

  direction LedgerEntryDirection
  
  idempotencyKey String @unique

  order   Order?   @relation(fields: [orderId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
  payout  SellerPayout? @relation(fields: [payoutId], references: [id])
  shop    Shop     @relation(fields: [shopId], references: [id])

  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([orderId])
  @@index([paymentId])
  @@index([payoutId])
  @@index([type])
  @@index([createdAt])
}











model SellerPayout {
  id String @id @default(uuid())

  shopId String

  amount Decimal
  currency String @default("INR")

  periodStart DateTime
  periodEnd   DateTime

  status SellerPayoutStatus @default(PENDING)

  provider String?
  providerPayoutId String?

  paidAt DateTime?
  failedAt DateTime?
  failureReason String?

  referenceId String?
  idempotencyKey String @unique

  shop Shop @relation(fields: [shopId], references: [id])

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([createdAt])
}










enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

model RefundRequest {
  id String @id @default(uuid())

  orderId String
  customerId String

  reason String
  note String?

  amount Decimal
  status RefundRequestStatus @default(PENDING)

  reviewedBy String?
  reviewedAt DateTime?
  rejectionReason String?

  providerRefundId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  customer User @relation(fields: [customerId], references: [id])

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}








model RiderPayout {
  id String @id @default(uuid())

  riderId String

  amount Decimal
  currency String @default("INR")

  periodStart DateTime
  periodEnd DateTime

  status RiderPayoutStatus @default(PENDING)

  provider String?
  providerPayoutId String?

  paidAt DateTime?
  failedAt DateTime?
  failureReason String?

  referenceId String?
  idempotencyKey String @unique

  rider Rider @relation(fields: [riderId], references: [id])

  ledgerEntries RiderLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riderId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([createdAt])
}











model RiderLedgerEntry {
  id String @id @default(uuid())

  riderId String

  deliveryId String?
  payoutId String?

  type RiderLedgerEntryType

  amount Decimal

  description String?
  referenceId String?

  direction RiderLedgerEntryDirection

  idempotencyKey String @unique

  rider Rider @relation(fields: [riderId], references: [id])
  delivery Delivery? @relation(fields: [deliveryId], references: [id])
  payout RiderPayout? @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now())

  @@index([riderId])
  @@index([deliveryId])
  @@index([payoutId])
  @@index([type])
  @@index([createdAt])
}