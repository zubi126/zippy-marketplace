generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SHOPKEEPER
  RIDER
  ADMIN
}




model User {
  id           String   @id @default(uuid())
  name         String?
  phone        String   @unique
  email        String?  @unique
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)

  shop Shop?
  rider Rider?
  addresses Address[]
  carts Cart[]
  orders Order[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}






model Shop {
  id      String @id @default(uuid())
  ownerId String @unique
  name    String
  slug    String @unique

  phone   String
  address String

  latitude  Decimal?
  longitude Decimal?
  paymentAccount SellerPaymentAccount?

  isOpen   Boolean @default(true)
  isActive Boolean @default(true)

  verificationStatus ShopVerificationStatus @default(PENDING)
rejectionReason String?

  products Product[]
  carts Cart[]
  orders Order[]
  transfers Transfer[]

  owner User @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Address {
  id     String @id @default(uuid())
  userId String

  label       String
  fullAddress String
  city        String
  state       String
  pincode     String

  latitude  Decimal?
  longitude Decimal?

  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String @unique
  isActive Boolean @default(true)

  parentId String?

products Product[]

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Product {
  id          String  @id @default(uuid())
  shopId      String
  categoryId  String

  name        String
  slug        String
  description String?

  price       Decimal
  imageUrl    String?

  isAvailable Boolean @default(true)

  shop        Shop     @relation(fields: [shopId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])

inventory Inventory?
cartItems CartItem[]
orderItems OrderItem[]
reviews Review[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, slug])
}




model Inventory {
  id               String @id @default(uuid())
  productId        String @unique

  quantity         Int @default(0)
  reservedQuantity Int @default(0)
  lowStockThreshold Int @default(5)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}






enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

model Cart {
  id         String     @id @default(uuid())
  customerId String
  shopId     String
  status     CartStatus @default(ACTIVE)

  customer User   @relation(fields: [customerId], references: [id])
  shop     Shop   @relation(fields: [shopId], references: [id])
  items    CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, shopId, status])
}




model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}









enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}


enum RiderStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
}



enum RiderVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}



enum ShopVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DeliveryStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}


model Order {
  id          String @id @default(uuid())
  orderNumber String @unique

  customerId String
  shopId     String

  subtotal    Decimal
  deliveryFee Decimal
  platformFee Decimal
  total       Decimal

  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)

  // Delivery address snapshot
  deliveryName        String
  deliveryPhone       String
  deliveryFullAddress String
  deliveryCity        String
  deliveryState       String
  deliveryPincode     String
  deliveryLatitude    Decimal?
  deliveryLongitude   Decimal?
  payment Payment?
  

  customer User @relation(fields: [customerId], references: [id])
  shop     Shop @relation(fields: [shopId], references: [id])

  items OrderItem[]
  transfers Transfer[]
  deliveries Delivery[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}






model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String

  productName String
  unitPrice   Decimal
  quantity    Int
  lineTotal   Decimal

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}







model Payment {
  id      String @id @default(uuid())
  orderId String @unique

  provider String
  amount   Decimal
  currency String @default("INR")

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique

  status PaymentStatus @default(PENDING)

  paidAt DateTime?

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}






model Rider {
  id String @id @default(uuid())
  userId String @unique
  vehicleType String?

  status RiderStatus @default(OFFLINE)

  verificationStatus RiderVerificationStatus @default(PENDING)
  rejectionReason String?

  currentLatitude Decimal?
  currentLongitude Decimal?

  user User @relation(fields: [userId], references: [id])
  deliveries Delivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}





model Delivery {
  id       String @id @default(uuid())
  orderId  String 
  riderId  String

  status DeliveryStatus @default(ASSIGNED)

  deliveryFee  Decimal
  riderEarning Decimal

  assignedAt  DateTime @default(now())
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  order Order @relation(fields: [orderId], references: [id])
  rider Rider @relation(fields: [riderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}









enum SellerPaymentAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model SellerPaymentAccount {
  id String @id @default(uuid())

  shopId String @unique

  provider String @default("razorpay")

  linkedAccountId String @unique

  status SellerPaymentAccountStatus @default(PENDING)


transfers Transfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])
}











enum TransferStatus {
  PENDING
  PROCESSED
  FAILED
  REVERSED
}

model Transfer {
  id String @id @default(uuid())

  orderId String
  shopId  String

  sellerPaymentAccountId String

  amount   Decimal
  currency String @default("INR")

  provider String @default("razorpay")

  razorpayTransferId String? @unique

  status TransferStatus @default(PENDING)

  processedAt DateTime?
  failedAt    DateTime?

  order                 Order                 @relation(fields: [orderId], references: [id])
  shop                  Shop                  @relation(fields: [shopId], references: [id])
  sellerPaymentAccount  SellerPaymentAccount @relation(fields: [sellerPaymentAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([shopId])
}









enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
}

model WebhookEvent {
  id String @id @default(uuid())

  provider String @default("razorpay")

  eventId   String @unique
  eventType String

  status WebhookEventStatus @default(PENDING)

  payload Json

  processedAt DateTime?
  failedAt    DateTime?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType])
  @@index([status])
}














model OtpVerification {
  id String @id @default(uuid())

  phone String

  sessionId String

  expiresAt DateTime

  attempts Int @default(0)

  verified Boolean @default(false)

  lastSentAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}









model Review {
  id String @id @default(uuid())

  customerId String
  productId  String
  orderId    String

  rating  Int
  comment String?

  customer User    @relation(fields: [customerId], references: [id])
  product  Product @relation(fields: [productId], references: [id])
  order    Order   @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productId, orderId])
  @@index([productId])
  @@index([customerId])
  @@index([orderId])
}